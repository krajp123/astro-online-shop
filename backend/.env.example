# Environment variables for the shared backend.
# Copy this file to .env and replace placeholder values before running the app.

PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_db"
MONGO_URI="mongodb://localhost:27017/ecommerce"

JWT_SECRET="change_me_super_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"

CUSTOMER_APP_URL="http://localhost:5173"
SELLER_APP_URL="http://localhost:5174"
ADMIN_APP_URL="http://localhost:5175"

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

STRIPE_SECRET_KEY="your_stripe_secret_key"
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
